<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_cream">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_white"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_back_landlord_appts"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/primary_black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_back_landlord_appts"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="HỆ THỐNG LỊCH HẸN"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lịch hẹn &amp; Khảo sát phòng"
                android:textColor="@color/primary_black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Horizontal Scrolling Calendar Strip (Monday to Sunday) -->
    <HorizontalScrollView
        android:id="@+id/scroll_calendar_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- T2 -->
            <LinearLayout
                android:id="@+id/day_t2"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_pill"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T2" android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="26" android:textColor="@color/primary_black" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 lịch" android:textColor="@color/text_muted" android:textSize="9sp"/>
            </LinearLayout>

            <!-- T3 -->
            <LinearLayout
                android:id="@+id/day_t3"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_pill"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T3" android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="27" android:textColor="@color/primary_black" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 lịch" android:textColor="@color/text_muted" android:textSize="9sp"/>
            </LinearLayout>

            <!-- T4 -->
            <LinearLayout
                android:id="@+id/day_t4"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_pill"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T4" android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="28" android:textColor="@color/primary_black" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 lịch" android:textColor="@color/text_muted" android:textSize="9sp"/>
            </LinearLayout>

            <!-- T5 (Active Today) -->
            <LinearLayout
                android:id="@+id/day_t5"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T5" android:textColor="#CBD5E1" android:textSize="11sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="29" android:textColor="@color/bg_white" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hôm nay" android:textColor="@color/accent_yellow" android:textSize="9sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- T6 -->
            <LinearLayout
                android:id="@+id/day_t6"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_pill"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T6" android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" android:textColor="@color/primary_black" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 lịch" android:textColor="@color/text_muted" android:textSize="9sp"/>
            </LinearLayout>

            <!-- T7 -->
            <LinearLayout
                android:id="@+id/day_t7"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_pill"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T7" android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="31" android:textColor="@color/primary_black" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 lịch" android:textColor="@color/text_muted" android:textSize="9sp"/>
            </LinearLayout>

            <!-- CN -->
            <LinearLayout
                android:id="@+id/day_cn"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_pill"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CN" android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="01" android:textColor="@color/primary_black" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 lịch" android:textColor="@color/text_muted" android:textSize="9sp"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Vertical Scrolling Booked Calendar / Appointments List -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_calendar_strip">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Appointment Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_landlord_appt_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/bg_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="#AVR-TOUR-2024-912"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_appt_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chờ xác nhận (còn 01:58:42)"
                            android:textColor="@color/accent_red"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="16:30 • Chiều nay, 29/10/2026"
                        android:textColor="@color/primary_black"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Studio ban công thoáng mát • Phòng 402 (4.2M/th)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/divider_color" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_chip_pill"
                            android:gravity="center"
                            android:text="🎓"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nguyễn Thanh Tùng"
                                android:textColor="@color/primary_black"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="K66 Viện CNTT - ĐH Bách Khoa • Đã xác thực Thẻ SV"
                                android:textColor="@color/accent_green"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_reject_appt"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_pill"
                            android:text="Từ chối"
                            android:textAllCaps="false"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_confirm_appt"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_primary"
                            android:text="Xác nhận lịch hẹn"
                            android:textAllCaps="false"
                            android:textColor="@color/bg_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Free Space / Empty State View (shown when no appointments on selected day) -->
            <LinearLayout
                android:id="@+id/layout_empty_appointments"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📭"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Không có lịch hẹn nào vào ngày này"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Vui lòng chọn ngày khác trên thanh lịch phía trên"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
