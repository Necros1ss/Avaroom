<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/student_bg_main">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#E6FFFFFF"
        android:paddingHorizontal="20dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <FrameLayout
                    android:id="@+id/btn_back_appointments"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/student_detail_bg_card_highlight"
                    android:backgroundTint="#E5EEFF">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="←"
                        android:textColor="@color/student_text_primary"
                        android:textSize="20sp" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVAROOM STUDIO"
                        android:textColor="@color/student_accent_red"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lịch hẹn xem phòng"
                        android:textColor="@color/student_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tabs: Sắp tới 01, Đã hoàn thành 02, Đã hủy 01 -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <LinearLayout
            android:id="@+id/btn_tab_upcoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/student_landlord_tab_active"
            android:backgroundTint="#030813"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sắp tới " android:textColor="@color/student_white" android:textSize="12sp" android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_badge_upcoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/student_success_bg_icon_circle"
                android:backgroundTint="@color/student_accent_red"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="0"
                android:textColor="@color/student_white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_tab_completed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/student_landlord_tab_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã hoàn thành " android:textColor="@color/student_text_secondary" android:textSize="12sp" android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_badge_completed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/student_success_bg_icon_circle"
                android:backgroundTint="@color/student_accent_red"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="0"
                android:textColor="@color/student_white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_tab_cancelled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/student_landlord_tab_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã hủy " android:textColor="@color/student_text_secondary" android:textSize="12sp" android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_badge_cancelled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/student_bg_chip_outline"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="0"
                android:textColor="@color/student_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Appointments Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_appointments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_appointments"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="90dp" />

            <ProgressBar
                android:id="@+id/progress_loading_appointments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_empty_appointments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Chưa có lịch hẹn nào"
                android:textColor="@color/student_text_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
