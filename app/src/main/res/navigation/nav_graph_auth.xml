<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_auth"
    app:startDestination="@id/onboarding1Fragment">

    <fragment
        android:id="@+id/onboarding1Fragment"
        android:name="com.avaroom.app.ui.auth.Onboarding1Fragment"
        android:label="Onboarding 1">
        <action
            android:id="@+id/action_onboarding1_to_onboarding2"
            app:destination="@id/onboarding2Fragment" />
    </fragment>

    <fragment
        android:id="@+id/onboarding2Fragment"
        android:name="com.avaroom.app.ui.auth.Onboarding2Fragment"
        android:label="Onboarding 2">
        <action
            android:id="@+id/action_onboarding2_to_onboarding3"
            app:destination="@id/onboarding3Fragment" />
    </fragment>

    <fragment
        android:id="@+id/onboarding3Fragment"
        android:name="com.avaroom.app.ui.auth.Onboarding3Fragment"
        android:label="Onboarding 3">
        <action
            android:id="@+id/action_onboarding3_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_onboarding3_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.avaroom.app.ui.auth.LoginFragment"
        android:label="Đăng nhập">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.avaroom.app.ui.auth.RegisterFragment"
        android:label="Đăng ký">
        <action
            android:id="@+id/action_register_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_register_to_otpFragment"
            app:destination="@id/otpFragment" />
        <action
            android:id="@+id/action_register_to_ekycFragment"
            app:destination="@id/ekycFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.avaroom.app.ui.auth.ForgotPasswordFragment"
        android:label="Quên mật khẩu">
        <action
            android:id="@+id/action_forgotPassword_to_otpFragment"
            app:destination="@id/otpFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpFragment"
        android:name="com.avaroom.app.ui.auth.OtpFragment"
        android:label="Xác thực OTP">
        <action
            android:id="@+id/action_otpFragment_to_resetPasswordFragment"
            app:destination="@id/resetPasswordFragment" />
        <action
            android:id="@+id/action_otpFragment_to_ekycFragment"
            app:destination="@id/ekycFragment" />
        <action
            android:id="@+id/action_otpFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/resetPasswordFragment"
        android:name="com.avaroom.app.ui.auth.ResetPasswordFragment"
        android:label="Đặt lại mật khẩu" />

    <fragment
        android:id="@+id/ekycFragment"
        android:name="com.avaroom.app.ui.ekyc.EkycFragment"
        android:label="Xác thực CCCD" />

</navigation>

