<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/student_bg_main">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#E6FFFFFF"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_back_change_appointment"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/student_detail_bg_card_highlight"
                android:backgroundTint="#E5EEFF">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="←"
                    android:textColor="@color/student_text_primary"
                    android:textSize="20sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Yêu cầu đổi lịch hẹn"
                android:textColor="@color/student_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Reschedule Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Step Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="THAO TÁC ĐẶT LỊCH"
                    android:textColor="@color/student_accent_red"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            </LinearLayout>

            <!-- Current Appointment Summary Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/student_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● LỊCH HẸN HIỆN TẠI • SẮP DIỄN RA" android:textColor="@color/student_accent_red" android:textSize="10sp" android:textStyle="bold" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#AVR-TOUR-2024-912" android:textColor="@color/student_text_muted" android:textSize="10sp" android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Studio ban công thoáng mát ĐH Bách Khoa"
                        android:textColor="@color/student_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/student_detail_bg_card_highlight"
                        android:backgroundTint="#F8FAFC"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕒 16:30 • Chủ Nhật, 13/10/2024" android:textColor="@color/student_text_primary" android:textSize="12sp" android:textStyle="bold" />
                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thời gian cũ" android:textColor="@color/student_text_muted" android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/student_bg_chip_dark" android:gravity="center" android:text="HT" android:textColor="@color/student_white" android:textSize="9sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Cô Hoàng Thị Ánh Tuyết • Chủ nhà Avaroom Verified" android:textColor="@color/student_text_secondary" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 1: Choose New Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="① Chọn ngày hẹn mới"
                android:textColor="@color/student_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Date 1: Selected -->
                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/student_landlord_tab_active"
                        android:backgroundTint="#030813"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THỨ 2" android:textColor="#94A3B8" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14" android:textColor="@color/student_white" android:textSize="22sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/student_success_bg_icon_circle" android:backgroundTint="#DC2626" android:paddingHorizontal="6dp" android:paddingVertical="1dp" android:text="Chiều mai" android:textColor="@color/student_white" android:textSize="8sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Date 2 -->
                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/student_detail_bg_card_highlight"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THỨ 3" android:textColor="@color/student_text_muted" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15" android:textColor="@color/student_text_primary" android:textSize="22sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tháng 10" android:textColor="@color/student_text_secondary" android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Date 3 -->
                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/student_detail_bg_card_highlight"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THỨ 4" android:textColor="@color/student_text_muted" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16" android:textColor="@color/student_text_primary" android:textSize="22sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tháng 10" android:textColor="@color/student_text_secondary" android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Date 4 -->
                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="80dp"
                        android:background="@drawable/student_detail_bg_card_highlight"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THỨ 5" android:textColor="@color/student_text_muted" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17" android:textColor="@color/student_text_primary" android:textSize="22sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tháng 10" android:textColor="@color/student_text_secondary" android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section 2: Choose New Time Slot -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="② Chọn khung giờ mới"
                android:textColor="@color/student_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Morning Slots -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️  BUỔI SÁNG" android:textColor="@color/student_text_muted" android:textSize="11sp" android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/student_bg_chip_outline"
                    android:padding="10dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:30 - 09:30" android:textColor="@color/student_text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="✓ Chủ nhà rảnh" android:textColor="@color/student_landlord_accent_green" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/student_bg_chip_outline"
                    android:padding="10dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="09:30 - 10:30" android:textColor="@color/student_text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="✓ Chủ nhà rảnh" android:textColor="@color/student_landlord_accent_green" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/student_bg_chip_outline"
                    android:backgroundTint="#F1F5F9"
                    android:padding="10dp"
                    android:orientation="vertical"
                    android:alpha="0.6">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:30 - 11:30" android:textColor="@color/student_text_muted" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="✕ Trùng lịch xem" android:textColor="@color/student_accent_red" android:textSize="10sp" />
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Afternoon & HUST Slots -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="⛑  BUỔI CHIỀU &amp; KHUNG TAN HỌC BÁCH KHOA" android:textColor="@color/student_text_muted" android:textSize="11sp" android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/student_bg_chip_outline"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16:30 - 17:30" android:textColor="@color/student_text_primary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="✓ Chủ nhà rảnh" android:textColor="@color/student_landlord_accent_green" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/student_bg_chip_outline" android:backgroundTint="#EFF4FF" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:text="Đón nắng chiều" android:textColor="#1D4ED8" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Selected Slot: 17:30 - 18:30 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#030813"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17:30 - 18:30" android:textColor="@color/student_white" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="✓ Cô Tuyết sẵn sàng mở cửa" android:textColor="#34D399" android:textSize="11sp" />
                        </LinearLayout>
                        <TextView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/student_success_bg_icon_circle" android:backgroundTint="#DC2626" android:gravity="center" android:text="✓" android:textColor="@color/student_white" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/student_search_bg_overlay_dark"
                        android:backgroundTint="#334155"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="🔥 Được 84% SV Bách Khoa chọn sau tiết 4"
                        android:textColor="#FDE047"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/student_bg_chip_outline"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18:30 - 19:30" android:textColor="@color/student_text_primary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="✓ Chủ nhà rảnh" android:textColor="@color/student_landlord_accent_green" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Buổi tối đèn đường" android:textColor="@color/student_text_secondary" android:textSize="10sp" />
            </LinearLayout>

            <!-- Section 3: Reason -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="③ Lý do thay đổi lịch hẹn"
                android:textColor="@color/student_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Gửi tin nhắn kèm lý do giúp chủ phòng dễ dàng thông cảm và sắp xếp tiếp đón chu đáo."
                android:textColor="@color/student_text_secondary"
                android:textSize="11sp" />

            <!-- Reason Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/student_landlord_tab_active"
                    android:backgroundTint="#030813"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="✓ Trùng lịch học / thi đột xuất"
                    android:textColor="@color/student_white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/student_bg_chip_outline"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Bận việc gia đình"
                    android:textColor="@color/student_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Note EditText -->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/student_bg_chip_outline"
                android:backgroundTint="#F8FAFC"
                android:gravity="top|start"
                android:padding="12dp"
                android:text="Lời nhắn gửi cô Tuyết:\nDạ cháu chào cô Tuyết, chiều mai lớp cháu có buổi thi bù đến 17h mới tan nên cháu xin phép dời sang khung 17h30 cô nhé. Cháu cảm ơn"
                android:textColor="@color/student_text_primary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:text="142/300 ký tự"
                android:textColor="@color/student_text_muted"
                android:textSize="10sp" />

            <!-- Policy Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/student_detail_bg_card_highlight"
                android:backgroundTint="#EFF4FF"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛡️ " android:textSize="16sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chính sách bảo lưu lịch Avaroom" android:textColor="@color/student_text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avaroom hỗ trợ đổi lịch miễn phí trước 2 giờ mà không bị trừ điểm uy tín sinh viên." android:textColor="@color/student_text_secondary" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Confirm Reschedule Button -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/student_landlord_btn_primary"
                android:backgroundTint="#DC2626"
                android:text="XÁC NHẬN ĐỔI LỊCH HẸN →"
                android:textColor="@color/student_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="Giữ nguyên lịch cũ &amp; Quay lại"
                android:textColor="@color/student_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
