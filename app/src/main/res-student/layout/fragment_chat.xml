<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/student_bg_main">

    <!-- Top Navigation Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#E6FFFFFF"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Button -->
            <FrameLayout
                android:id="@+id/btn_back_chat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/student_detail_bg_card_highlight"
                android:backgroundTint="#E5EEFF"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="←"
                    android:textColor="@color/student_text_primary"
                    android:textSize="20sp" />
            </FrameLayout>

            <!-- Landlord Avatar -->
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp">
                <TextView
                    android:id="@+id/tv_header_avatar_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/student_bg_chip_dark"
                    android:gravity="center"
                    android:text="👩‍💼"
                    android:textSize="18sp" />
                <ImageView
                    android:id="@+id/iv_header_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/student_success_bg_icon_circle"
                    android:backgroundTint="#10B981" />
            </FrameLayout>

            <!-- Landlord Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_landlord_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Chủ trọ"
                        android:textColor="@color/student_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_landlord_verified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="✓"
                        android:textColor="@color/student_landlord_accent_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_landlord_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chủ trọ Avaroom"
                    android:textColor="@color/student_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Call Button -->
            <FrameLayout
                android:id="@+id/btn_call_landlord"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/student_detail_bg_card_highlight"
                android:backgroundTint="#F1F5F9"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📞"
                    android:textSize="14sp" />
            </FrameLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Pinned Room Listing Card (Optional, visible if conversation has room) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_pinned_listing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/student_white"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/student_detail_bg_card_highlight">
                <ImageView
                    android:id="@+id/iv_room_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/student_img_room_1" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_room_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/student_bg_chip_outline"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="#AVR-Phòng"
                    android:textColor="@color/student_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_room_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/student_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Phòng trọ cao cấp" />

                <TextView
                    android:id="@+id/tv_room_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/student_accent_red"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="3.500.000đ/tháng" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Message Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_message_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_input"
        app:layout_constraintTop_toBottomOf="@id/card_pinned_listing">

        <!-- RecyclerView hiển thị tin nhắn -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progress_loading_messages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/student_accent_red"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layout_empty_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Chưa có tin nhắn nào"
                android:textColor="@color/student_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Hãy gửi tin nhắn đầu tiên để liên hệ hỏi thông tin phòng trọ với chủ trọ."
                android:textColor="@color/student_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Error State View -->
        <LinearLayout
            android:id="@+id/layout_error_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Không thể tải lịch sử tin nhắn"
                android:textColor="@color/student_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_retry_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/student_detail_bg_card_highlight"
                android:backgroundTint="@color/student_accent_red"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="Thử lại"
                android:textColor="@color/student_white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Chat Input Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6FFFFFF"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/student_bg_room_card"
            android:backgroundTint="@color/student_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            app:layout_constraintTop_toTopOf="parent">

            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/student_bg_chip_outline"
                android:backgroundTint="#F1F5F9"
                android:hint="Nhập tin nhắn..."
                android:paddingHorizontal="12dp"
                android:textColor="@color/student_text_primary"
                android:textColorHint="@color/student_text_muted"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/btn_send_chat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/student_landlord_btn_primary"
                android:backgroundTint="#0F172A"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:id="@+id/tv_send_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="➤"
                    android:textColor="@color/student_white"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
