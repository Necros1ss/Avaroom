<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/student_bg_main">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#E6FFFFFF"
        android:paddingHorizontal="20dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <FrameLayout
                    android:id="@+id/btn_back_appointments"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/student_detail_bg_card_highlight"
                    android:backgroundTint="#E5EEFF">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="←"
                        android:textColor="@color/student_text_primary"
                        android:textSize="20sp" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVAROOM STUDIO"
                        android:textColor="@color/student_accent_red"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lịch hẹn xem phòng"
                        android:textColor="@color/student_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tabs: Sắp tới 01, Đã hoàn thành 02, Đã hủy 01 -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <LinearLayout
            android:id="@+id/btn_tab_upcoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/student_landlord_tab_active"
            android:backgroundTint="#030813"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sắp tới " android:textColor="@color/student_white" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/student_success_bg_icon_circle" android:backgroundTint="@color/student_accent_red" android:paddingHorizontal="6dp" android:paddingVertical="1dp" android:text="01" android:textColor="@color/student_white" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_tab_completed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/student_landlord_tab_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã hoàn thành " android:textColor="@color/student_text_secondary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/student_success_bg_icon_circle" android:backgroundTint="@color/student_accent_red" android:paddingHorizontal="6dp" android:paddingVertical="1dp" android:text="02" android:textColor="@color/student_white" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_tab_cancelled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/student_landlord_tab_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã hủy " android:textColor="@color/student_text_secondary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/student_bg_chip_outline" android:paddingHorizontal="6dp" android:paddingVertical="1dp" android:text="01" android:textColor="@color/student_text_secondary" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Appointments Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Container 1: Upcoming Appointments -->
            <LinearLayout
                android:id="@+id/container_upcoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Urgent 24h Banner -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFE4E6"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"/>

                <!-- Appointment Detail Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/student_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mã đặt hẹn:" android:textColor="@color/student_text_muted" android:textSize="10sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#AVR-TOUR-2024-912" android:textColor="@color/student_text_primary" android:textSize="12sp" android:textStyle="bold" />
                            </LinearLayout>
                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/student_landlord_bg_commit_card"
                                android:backgroundTint="#ECFDF5"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ " android:textColor="@color/student_landlord_accent_green" android:textSize="10sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chủ trọ đã xác nhận" android:textColor="@color/student_landlord_accent_green" android:textSize="11sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/student_detail_bg_card_highlight"
                            android:backgroundTint="#F8FAFC"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp">
                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/student_img_room_1" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom|start"
                                    android:layout_margin="2dp"
                                    android:background="@drawable/student_search_bg_overlay_dark"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="1dp"
                                    android:text="#AVR-90412"
                                    android:textColor="@color/student_white"
                                    android:textSize="8sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/student_bg_chip_outline"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="STUDIO BAN CÔNG • 28m²"
                                    android:textColor="@color/student_text_secondary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Studio ban công thoáng..."
                                    android:textColor="@color/student_text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Số 42 Ngõ 187 Tạ Quang Bửu, P. Bách Khoa, Q. Hai Bà Trưng, Hà Nội"
                                    android:textColor="@color/student_text_secondary"
                                    android:textSize="11sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Directions Button Bar -->

                        <!-- Landlord Info Bar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/student_bg_chip_dark"
                                    android:gravity="center"
                                    android:text="👩‍💼"
                                    android:textSize="18sp" />
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cô Hoàng Thị Ánh Tuyết" android:textColor="@color/student_text_primary" android:textSize="13sp" android:textStyle="bold" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="✓" android:textColor="@color/student_landlord_accent_green" android:textSize="11sp" android:textStyle="bold" />
                                </LinearLayout>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0912 ••• 882 • Xác thực CCCD" android:textColor="@color/student_text_secondary" android:textSize="11sp" />
                            </LinearLayout>
                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/student_detail_bg_card_highlight"
                                android:backgroundTint="#E5EEFF">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="📞" android:textSize="14sp" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/student_detail_bg_card_highlight"
                                android:backgroundTint="#E5EEFF">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="💬" android:textSize="14sp" />
                            </FrameLayout>
                        </LinearLayout>

                        <!-- Student Note Card -->

                        <!-- Action Buttons Footer -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/btn_reschedule_appointment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="Đổi lịch hẹn"
                                android:textColor="@color/student_text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="Hủy lịch hẹn"
                                android:textColor="@color/student_accent_red"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />
                            <Button
                                android:id="@+id/btn_view_appointment_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:background="@drawable/student_landlord_btn_primary"
                                android:backgroundTint="#030813"
                                android:paddingHorizontal="16dp"
                                android:text="Xem chi tiết"
                                android:textColor="@color/student_white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Container 2: Completed Appointments -->
            <LinearLayout
                android:id="@+id/container_completed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="LỊCH SỬ XEM PHÒNG GẦN ĐÂY • 2 chuyến xem trước"
                    android:textColor="@color/student_accent_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <!-- Completed Card 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/student_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08/10/2024 • #AVR-89201" android:textColor="@color/student_text_muted" android:textSize="11sp" android:textStyle="bold" />
                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/student_bg_chip_outline" android:backgroundTint="#E5EEFF" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:text="Hoàn tất" android:textColor="#1D4ED8" android:textSize="11sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/student_detail_bg_card_highlight"
                            android:backgroundTint="#F8FAFC"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp">
                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/student_img_room_2" />
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Studio gác lửng Trần..." android:textColor="@color/student_text_primary" android:textSize="14sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="✓ Đã xem phòng xong" android:textColor="@color/student_landlord_accent_green" android:textSize="11sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_write_review_completed"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/student_landlord_btn_primary"
                            android:backgroundTint="#030813"
                            android:text="✍️ Viết đánh giá"
                            android:textColor="@color/student_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Container 3: Cancelled Appointments -->
            <LinearLayout
                android:id="@+id/container_cancelled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="LỊCH XEM PHÒNG ĐÃ HỦY"
                    android:textColor="@color/student_accent_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <!-- Cancelled Card 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/student_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23/09/2024 • #AVR-81726" android:textColor="@color/student_text_muted" android:textSize="11sp" android:textStyle="bold" />
                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/student_bg_chip_outline" android:backgroundTint="#FFE4E6" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:text="Đã hủy" android:textColor="@color/student_accent_red" android:textSize="11sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/student_detail_bg_card_highlight"
                            android:backgroundTint="#F8FAFC"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp">
                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/student_img_room_1" />
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Căn hộ mini Lê Thanh..." android:textColor="@color/student_text_primary" android:textSize="14sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Chủ trọ: Bác Nguyễn Văn Hùng" android:textColor="@color/student_text_secondary" android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <TextView
                                android:id="@+id/btn_view_cancelled_room"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="4dp"
                                android:text="Xem chi tiết phòng ›"
                                android:textColor="@color/student_accent_red"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
