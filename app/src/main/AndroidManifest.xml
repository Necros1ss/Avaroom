<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyền truy cập mạng cho Retrofit -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Avaroom">

        <!-- Landlord Flow Main Activity -->
        <activity
            android:name=".ui.landlord.LandlordMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- Entry Point: Onboarding & Auth Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
        </activity>

        <!-- Student Flow Main Activity -->
        <activity
            android:name=".ui.student.StudentMainActivity"
            android:exported="true" />



    </application>

</manifest>
