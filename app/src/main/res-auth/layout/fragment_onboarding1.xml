<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_cream"
    android:padding="24dp">

    <!-- Top illustration mockup card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_preview"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/bg_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="📍 ĐH Bách Khoa · 850m"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tuyến xe bus 08A, 26, 31 đi thẳng"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Từ 2.8tr / tháng"
                android:textColor="@color/accent_red"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3 Quick Discovery Tags from Figma -->
    <HorizontalScrollView
        android:id="@+id/scroll_quick_tags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/card_preview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="📍 Gần trường học"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="⏱️ &lt; 10 phút đi bộ"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="🛡️ Phòng chính chủ"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp"
        android:text="Tìm trọ gần trường\nchỉ trong tích tắc."
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/scroll_quick_tags"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Định vị bản đồ quanh trường, lọc nhanh theo bán kính và tuyến xe buýt thuận tiện, bảo đảm minh bạch giá cả &amp; an ninh sinh viên."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4 Step Pagination Dots from Figma -->
    <LinearLayout
        android:id="@+id/layout_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btn_next_onboarding"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="24dp"
            android:layout_height="4dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_pill"
            android:backgroundTint="@color/primary_black" />

        <View
            android:layout_width="8dp"
            android:layout_height="4dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_pill"
            android:backgroundTint="@color/border_subtle" />

        <View
            android:layout_width="8dp"
            android:layout_height="4dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_pill"
            android:backgroundTint="@color/border_subtle" />

        <View
            android:layout_width="8dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_chip_pill"
            android:backgroundTint="@color/border_subtle" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next_onboarding"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_button_primary"
        android:text="Tiếp tục →"
        android:textAllCaps="false"
        android:textColor="@color/bg_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
